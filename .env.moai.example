# ============================================
# MOAI Tenant - moai.efeito.digital
# ============================================
# Configurar no Vercel Project Settings > Environment Variables
# (escopo: Production + Preview + Development conforme necessário).
#
# Após setar, o mesmo build do Ad Flow vai servir o subdomínio
# moai.efeito.digital com branding total MOAI:
#   - Header navy #1A1F36 sem "powered by Ad Flow"
#   - Landing redireciona direto pra /moai/executive
#   - Rotas /c/:slug bloqueadas (multi-cliente)
#   - Tenant lock via env var (build-time)
# ============================================

# Identifica esse build como MOAI tenant
VITE_TENANT=moai

# Reutiliza Supabase + Meta + Google Ads existentes do Ad Flow
VITE_SUPABASE_URL=https://sdtyynzyfvxigwfmzayk.supabase.co
VITE_SUPABASE_ANON_KEY=<copia do .env do Ad Flow>

# Monday é específico de tenant MOAI - token salvo em client_integrations
# (não precisa env var, vem do DB via service_role)

# Mesma config Vercel - apenas DNS aponta pra outro domínio
# Vercel Project > Domains > Add: moai.efeito.digital
