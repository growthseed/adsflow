{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/sync/clickup.ts":     { "maxDuration": 120 },
    "api/sync/performance.ts": { "maxDuration": 120 },
    "api/reports/generate.ts": { "maxDuration": 60 },
    "api/crons/run.ts":        { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/sync/clickup",                    "schedule": "0 7 * * *" },
    { "path": "/api/sync/performance",                "schedule": "0 8 * * *" },
    { "path": "/api/crons/run?job=pacing-tick",       "schedule": "17 9 * * *" },
    { "path": "/api/crons/run?job=alerts-evaluate",   "schedule": "23 9 * * *" },
    { "path": "/api/crons/run?job=reports-deliver",   "schedule": "31 9 * * *" }
  ]
}
