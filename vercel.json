{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/sync/clickup.ts": {
      "maxDuration": 120
    },
    "api/sync/performance.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/sync/clickup",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/sync/performance",
      "schedule": "0 8 * * *"
    }
  ]
}
